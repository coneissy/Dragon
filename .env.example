# Binance connection
BINANCE_API_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_API_BASE=https://fapi.binance.com

# Runtime mode — keep paper mode until validation is complete
DRY_RUN=true
LIVE_TRADING=false

# MAX UNIVERSE v5 economics
# 3 bps hard minimum net edge after costs.
MIN_NET_EDGE_BPS=3
# 0 = no fixed dollar cap; runtime allocates 95% of balance above the reserve.
MAX_NOTIONAL_USDT=0
MAX_SLIPPAGE_BPS=3
FEE_BPS=10
ARB_RISK_PCT=0.0015
# 5 USDT exchange minimum; MAX UNIVERSE starts with 9 USDT and keeps 1 USDT reserve.
MIN_TRADE_NOTIONAL_USDT=5
ARB_CAPITAL_ALLOCATION_PCT=0.95
ARB_SAFETY_RESERVE_USDT=1

# Optional spot triangle universe exclusions (comma-separated base assets).
EXCLUDED_BASE_ASSETS=

# MAX UNIVERSE runtime controls
LIVE_ORDER_COOLDOWN_MS=0
ORDER_TIMEOUT_MS=5000
STALE_MS=500
DEPTH_LEVELS=20
MAX_TRIANGLES=0
STREAM_SYMBOL_CAP=0
POLL_INTERVAL_SECONDS=0.02
POSITION_TIMEOUT_SECONDS=15
MAX_CONSECUTIVE_LOSSES=5
MAX_DRAWDOWN_PCT=15
LEDGER_PATH=/tmp/dragon_ledger.sqlite3

# Binance USDⓈ-M controls
# Futures discovery is part of the profile; keep real futures execution disabled
# until the spot/perp adapter has passed paper validation.
FUTURES_ENABLED=true
FUTURES_LIVE_TRADING=false
FUTURES_POLL_SECONDS=1
FUTURES_MAX_SYMBOLS=0
FUTURES_MAX_NOTIONAL_USDT=0
FUTURES_ORDER_NOTIONAL_USDT=0
FUTURES_MIN_NET_EDGE_BPS=3
FUTURES_FEE_BPS=4
FUTURES_FUNDING_BUFFER_BPS=3
FUTURES_RISK_PCT=0.0015
